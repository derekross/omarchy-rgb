#!/usr/bin/env python3
"""Drive RGB devices with effects colored by the current Omarchy theme.

Usage:
  omarchy-rgb                      Show the current effect
  omarchy-rgb effect EFFECT        Switch effect: static, pulse, wave, manual or off
  omarchy-rgb room on|off|toggle   Include room lights (Philips Hue) in the effect
  omarchy-rgb status               Effect, colors and devices as JSON
  omarchy-rgb daemon               Run the effect loop (started by the plugin)

static, pulse and wave follow the theme. manual stops sending colors, so ones
set in the OpenRGB app (or the devices' own lighting) take over; off is dark.

Talks to an OpenRGB SDK server on 127.0.0.1:6742 (also started by the plugin)
using only the standard library. static and pulse use the theme's keyboard.rgb,
falling back to its accent color; wave uses the theme colors around its accent
plus its keyboard.rgb, swept across each device's physical layout. The daemon
picks up theme
and effect changes on its own. Corsair VOID headsets, which OpenRGB doesn't
support yet, are driven directly over hidraw.

Room lights (Philips Hue Entertainment areas in OpenRGB) are only driven while
room sync is on. Their colors are saved from the Hue bridge first and put back
when sync turns off, since the lights keep the last streamed color otherwise.
"""

import colorsys
import fcntl
import hashlib
import http.client
import ipaddress
import json
import math
import os
import re
import select
import signal
import socket
import ssl
import struct
import sys
import tempfile
import time
from pathlib import Path

HOST, PORT = "127.0.0.1", 6742
PROTOCOL = 5
CLIENT_NAME = b"omarchy-rgb\0"

THEME = Path.home() / ".local/state/omarchy/current/theme"
STATE = Path.home() / ".local/state/omarchy/rgb-effect"
STATUS = Path.home() / ".local/state/omarchy/rgb-status.json"
ROOM = Path.home() / ".local/state/omarchy/rgb-room"
ROOM_SNAPSHOT = Path.home() / ".local/state/omarchy/rgb-room-snapshot.json"
BRIDGE_PIN = Path.home() / ".local/state/omarchy/rgb-hue-bridge.json"
OPENRGB_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "OpenRGB/OpenRGB.json"
LOCK = Path(os.environ.get("XDG_RUNTIME_DIR") or STATE.parent) / "omarchy-rgb.lock"
# static, pulse and wave follow the theme. manual leaves devices alone so
# colors set in the OpenRGB app (or the devices' own lighting) stay; off is dark.
EFFECTS = ("static", "pulse", "wave", "manual", "off")
DEFAULT_EFFECT = "static"

FPS = 30
PULSE_PERIOD = 4.0      # seconds per breath
PULSE_FLOOR = 0.15      # dimmest point of a breath
WAVE_PERIOD = 6.0       # seconds for the palette to sweep past a point
WAVE_HUE_RANGE = 1 / 6  # theme colors within 60 degrees of the main color
LED_SATURATION = 1.0    # minimum saturation for wave colors (1.0 = pure hues)
STATIC_REFRESH = 2.0    # resend static colors to cover replugged devices

PKT_CONTROLLER_COUNT = 0
PKT_CONTROLLER_DATA = 1
PKT_PROTOCOL_VERSION = 40
PKT_SET_CLIENT_NAME = 50
PKT_DEVICE_LIST_UPDATED = 100
PKT_REQUEST_RESCAN = 140
PKT_UPDATE_LEDS = 1050
PKT_SET_CUSTOM_MODE = 1100
PKT_UPDATE_MODE = 1101

NO_LED = 0xFFFFFFFF
# Largest packet accepted from the SDK server. A device's description with
# thousands of LEDs is a few hundred KB; anything near this is refused rather
# than read into memory.
MAX_PACKET = 1 << 22
# A device reports its LED count as a uint16, so no zone can need more, and
# no real server lists anywhere near this many devices.
MAX_LEDS = 0xFFFF
MAX_DEVICES = 256

# Room lights light the room, not the desk, so they're only driven while room
# sync is on. Only Hue Entertainment areas, which stream; OpenRGB's per-bulb Hue
# devices go through a bridge that takes a few commands a second.
ROOM_LIGHTS = ("Philips Hue",)
ROOM_STREAMING = "Philips Hue Entertainment"
ROOM_RETRY = 30.0       # seconds between attempts to put room lights back
BRIDGE_MAX_BODY = 1 << 20

# OpenRGB device_type values (RGBController.h) for the status shown in the panel.
DEVICE_TYPES = {0: "motherboard", 1: "memory", 2: "gpu", 3: "cooler", 4: "ledstrip",
                5: "keyboard", 6: "mouse", 7: "mousemat", 8: "headset",
                9: "headset-stand", 10: "gamepad", 11: "light", 12: "speaker",
                14: "storage", 15: "case", 16: "microphone", 18: "keypad",
                19: "laptop", 20: "monitor"}

# Corsair VOID wireless receivers using the C8/CB lighting protocol (SignalRGB
# covers these with one plugin; only 0x0A1A has been tested here).
VOID_PIDS = {0x0A14, 0x0A16, 0x0A17, 0x0A1A, 0x0A1D}
HEADSET_SCAN = 5.0      # seconds between hotplug scans / take-control resends


# Theme colors

def hex_rgb(value):
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def theme_colors():
    try:
        text = (THEME / "colors.toml").read_text()
    except OSError:
        return {}
    return {k: v.lower() for k, v in re.findall(r'^(\w+)\s*=\s*"#([0-9A-Fa-f]{6})"', text, re.M)}


def keyboard_color():
    """The theme's own keyboard color (keyboard.rgb), or None if it has none."""
    try:
        value = (THEME / "keyboard.rgb").read_text().strip().lstrip("#")
    except OSError:
        return None
    return hex_rgb(value.lower()) if re.fullmatch(r"[0-9A-Fa-f]{6}", value) else None


def led_color(rgb):
    """Theme colors are tuned as text on a dark background; LEDs show pastels
    washed out. Keep the hue but push saturation and brightness up."""
    h, s, v = colorsys.rgb_to_hsv(*(c / 255 for c in rgb))
    if s < 0.12:
        return rgb                      # grey/white: nothing to saturate
    r, g, b = colorsys.hsv_to_rgb(h, max(s, LED_SATURATION), 1.0)
    return (round(r * 255), round(g * 255), round(b * 255))


def hue_distance(a, b):
    return min(abs(a - b), 1 - abs(a - b))


def hue(rgb):
    return colorsys.rgb_to_hsv(*(c / 255 for c in rgb))[0]


def wave_palette(colors, center, keyboard=None):
    """Colors around center (the theme accent): every saturated theme color within
    WAVE_HUE_RANGE of its hue, plus the theme's keyboard color if it has one,
    ordered by hue and made LED-friendly. The full terminal palette spans every
    hue, so using all of it reads as a generic rainbow rather than the theme."""
    skip = ("background", "foreground", "selection", "muted", "cursor", "brown")
    center_s = colorsys.rgb_to_hsv(*(c / 255 for c in center))[1]
    if center_s < 0.12:
        # Monochrome accent: build around the keyboard color if there is one,
        # otherwise sweep between the accent and a dim shade of it.
        if keyboard is None:
            return [center, scale(center, 0.25)]
        center, keyboard = keyboard, None
    center_h = hue(center)

    picked = [led_color(center)]

    def add(rgb):
        candidate = led_color(rgb)
        if all(hue_distance(hue(candidate), hue(p)) > 0.03 for p in picked):
            picked.append(candidate)

    for name, value in colors.items():
        if any(s in name for s in skip):
            continue
        h, s, v = colorsys.rgb_to_hsv(*(c / 255 for c in hex_rgb(value)))
        if s < 0.25 or v < 0.3 or hue_distance(h, center_h) > WAVE_HUE_RANGE:
            continue
        add(hex_rgb(value))
    if keyboard is not None:
        add(keyboard)

    # Order by hue relative to center so the gradient doesn't jump
    # across the red/violet wrap-around, then bounce back so it loops smoothly.
    def offset(rgb):
        return (hue(rgb) - center_h + 0.5) % 1.0 - 0.5
    picked.sort(key=offset)
    if len(picked) < 2:
        return [picked[0], scale(picked[0], 0.35)]
    return picked + picked[-2:0:-1]


# Color math

def scale(rgb, factor):
    return tuple(round(c * factor) for c in rgb)


def mix(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def sample(palette, u):
    """Sample a cyclic gradient through palette at u in [0, 1)."""
    pos = (u % 1.0) * len(palette)
    i = int(pos)
    return mix(palette[i], palette[(i + 1) % len(palette)], pos - i)


# OpenRGB SDK client

class Reader:
    def __init__(self, data):
        self.data, self.pos = data, 0

    def take(self, fmt):
        values = struct.unpack_from("<" + fmt, self.data, self.pos)
        self.pos += struct.calcsize("<" + fmt)
        return values if len(values) > 1 else values[0]

    def array(self, count, fmt="I"):
        if count * struct.calcsize("<" + fmt) > len(self.data) - self.pos:
            raise ConnectionError("truncated packet from OpenRGB server")
        values = struct.unpack_from(f"<{count}{fmt}", self.data, self.pos)
        self.pos += struct.calcsize(f"<{count}{fmt}")
        return values

    def string(self):
        n = self.take("H")
        value = self.data[self.pos:self.pos + n].rstrip(b"\0").decode(errors="replace")
        self.pos += n
        return value


class Device:
    def __init__(self, index, data, version):
        r = Reader(data)
        r.take("I")                                 # data size
        self.type = DEVICE_TYPES.get(r.take("i"), "device")
        self.name = r.string().strip()
        if version >= 1:
            r.string()                              # vendor
        self.description = r.string()
        for _ in range(3):
            r.string()                              # version, serial, location
        mode_count = r.take("H")
        r.take("i")                                 # active mode
        # Each mode's description is kept as sent, to select it by name with
        # PKT_UPDATE_MODE, which takes the same layout back.
        self.modes = {}
        for mode_index in range(mode_count):
            start = r.pos
            mode_name = r.string()
            r.take("iIII")                          # value, flags, speed min/max
            if version >= 3:
                r.take("II")                        # brightness min/max
            r.take("III")                           # colors min/max, speed
            if version >= 3:
                r.take("I")                         # brightness
            r.take("II")                            # direction, color mode
            r.array(r.take("H"))                    # mode colors
            self.modes[mode_name] = (mode_index, data[start:r.pos])
        self.positions = []
        for _ in range(r.take("H")):                # zones
            r.string()
            zone_type, _, _, count = r.take("iIII")
            if len(self.positions) + count > MAX_LEDS:
                raise ConnectionError("too many LEDs from OpenRGB server")
            zone = [(i / max(count - 1, 1), 0.5) for i in range(count)]
            if r.take("H"):
                height, width = r.take("II")
                for cell, led in enumerate(r.array(height * width)):
                    if led != NO_LED and led < count:
                        row, col = divmod(cell, width)
                        zone[led] = (col / max(width - 1, 1), row / max(height - 1, 1))
            if version >= 4:
                for _ in range(r.take("H")):        # segments
                    r.string()
                    r.take("iII")
            if version >= 5:
                r.take("I")                         # zone flags
            self.positions.extend(zone)
        self.index = index
        self.room = self.description.startswith(ROOM_LIGHTS)
        self.led_count = r.take("H")
        # Zones normally account for every LED; pad if a device reports extras.
        while len(self.positions) < self.led_count:
            self.positions.append((0.5, 0.5))
        del self.positions[self.led_count:]


class Client:
    def __init__(self):
        self.sock = socket.create_connection((HOST, PORT), timeout=5)
        self.send(0, PKT_PROTOCOL_VERSION, struct.pack("<I", PROTOCOL))
        server = struct.unpack("<I", self.recv(PKT_PROTOCOL_VERSION))[0]
        self.version = min(server, PROTOCOL)
        self.send(0, PKT_SET_CLIENT_NAME, CLIENT_NAME)
        self.devices_changed = False

    def close(self):
        self.sock.close()

    def send(self, device, packet, data=b""):
        self.sock.sendall(b"ORGB" + struct.pack("<III", device, packet, len(data)) + data)

    def read_exact(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("OpenRGB server closed the connection")
            buf += chunk
        return buf

    def read_packet(self):
        header = self.read_exact(16)
        if header[:4] != b"ORGB":
            raise ConnectionError("bad packet from OpenRGB server")
        _, packet, size = struct.unpack("<III", header[4:])
        if size > MAX_PACKET:
            raise ConnectionError("oversized packet from OpenRGB server")
        data = self.read_exact(size)
        if packet == PKT_DEVICE_LIST_UPDATED:
            self.devices_changed = True
        return packet, data

    def recv(self, want):
        while True:
            packet, data = self.read_packet()
            if packet == want:
                return data

    def drain(self):
        """Consume unsolicited packets so the server never blocks on us."""
        while select.select([self.sock], [], [], 0)[0]:
            self.read_packet()

    def devices(self):
        self.send(0, PKT_CONTROLLER_COUNT)
        count = struct.unpack("<I", self.recv(PKT_CONTROLLER_COUNT))[0]
        if count > MAX_DEVICES:
            raise ConnectionError("too many devices from OpenRGB server")
        devices = []
        for i in range(count):
            self.send(i, PKT_CONTROLLER_DATA, struct.pack("<I", self.version))
            device = Device(i, self.recv(PKT_CONTROLLER_DATA), self.version)
            devices.append(device)
            if not device.room:                     # room lights wait for room sync
                self.send(i, PKT_SET_CUSTOM_MODE)
        self.devices_changed = False
        return devices

    def set_mode(self, device, name):
        """Select one of the device's modes by name."""
        index, description = device.modes[name]
        body = struct.pack("<i", index) + description
        self.send(device.index, PKT_UPDATE_MODE, struct.pack("<I", 4 + len(body)) + body)

    def rescan(self):
        """Ask the server to detect devices again; it announces the new list
        with a device-list-updated packet."""
        self.send(0, PKT_REQUEST_RESCAN)

    def update(self, device, colors):
        payload = b"".join(struct.pack("<I", r | g << 8 | b << 16) for r, g, b in colors)
        size = 4 + 2 + len(payload)
        self.send(device.index, PKT_UPDATE_LEDS, struct.pack("<IH", size, len(colors)) + payload)


# Corsair VOID headsets

class Headset:
    """A Corsair VOID-family wireless headset, driven directly over hidraw since
    OpenRGB has no driver for it yet. Protocol from SignalRGB's VOID PRO plugin
    and OpenRGB draft MR !1079, confirmed on a VOID PRO Wireless (1b1c:0a1a):

      C8 01 / C8 00   take lighting from the firmware / hand it back (the mic
                      mute LED only works while the firmware has it)
      CB 06 1C r 16 g 17 b 1D r 18 g 19 b
                      set the left and right earcup colors (register pairs)
    """

    led_count = 2
    positions = [(0.0, 0.5), (0.5, 0.5)]    # earcups half a wave apart
    type = "headset"
    name = "Corsair VOID headset"

    def __init__(self, path):
        self.file = open(path, "wb", buffering=0)
        self.controlled = False

    def take_control(self):
        self.file.write(bytes([0xC8, 0x01, 0x00]))
        self.controlled = True

    def hand_back(self):
        if self.controlled:
            self.file.write(bytes([0xC8, 0x00, 0x00]))
            self.controlled = False

    def update(self, colors):
        (lr, lg, lb), (rr, rg, rb) = colors
        self.file.write(bytes([0xCB, 0x06, 0x1C, lr, 0x16, lg, 0x17, lb,
                               0x1D, rr, 0x18, rg, 0x19, rb]) + bytes(6))

    def release(self):
        try:
            self.hand_back()
        except OSError:
            pass
        self.close()

    def close(self):
        try:
            self.file.close()
        except OSError:
            pass


def output_report_ids(descriptor):
    """Report IDs of a HID report descriptor's Output items."""
    ids, report_id, i = set(), None, 0
    while i < len(descriptor):
        prefix = descriptor[i]
        if prefix == 0xFE:                          # long item
            i += 3 + descriptor[i + 1]
            continue
        size = (0, 1, 2, 4)[prefix & 3]
        value = int.from_bytes(descriptor[i + 1:i + 1 + size], "little")
        if prefix & 0xFC == 0x84:                   # Report ID
            report_id = value
        elif prefix & 0xFC == 0x90:                 # Output
            ids.add(report_id)
        i += 1 + size
    return ids


def usb_hid_devices():
    """The USB HID devices present, to notice plugging and unplugging. The
    OpenRGB server doesn't hotplug, so it has to be told to rescan."""
    found = set()
    for node in Path("/sys/class/hidraw").glob("hidraw*"):
        try:
            uevent = (node / "device/uevent").read_text()
        except OSError:
            continue
        match = re.search(r"^HID_ID=(0003:\S+)$", uevent, re.M)
        if match:
            found.add((node.name, match.group(1)))
    return found


def find_headsets():
    """hidraw nodes of VOID headset receivers' lighting interfaces: the ones
    that accept both the lights (0xC8) and register (0xCB) output reports."""
    found = []
    for node in sorted(Path("/sys/class/hidraw").glob("hidraw*")):
        try:
            uevent = (node / "device/uevent").read_text()
            descriptor = (node / "device/report_descriptor").read_bytes()
        except OSError:
            continue
        match = re.search(r"^HID_ID=0003:00001B1C:0000([0-9A-F]{4})$", uevent, re.M)
        if not match or int(match.group(1), 16) not in VOID_PIDS:
            continue
        if {0xC8, 0xCB} <= output_report_ids(descriptor):
            found.append(f"/dev/{node.name}")
    return found


# Room lights (Philips Hue)

class RoomError(Exception):
    pass


class HueBridge:
    """The Hue bridge OpenRGB is paired with, over its local REST API, to save
    the room lights' colors before streaming and put them back after.

    Bridges serve HTTPS with a certificate no system CA signs, so it's pinned
    on first use: its SHA-256 is saved to BRIDGE_PIN, tied to the bridge key,
    and every later connection must present the same certificate before the
    key is sent. Pairing OpenRGB with a new key starts a new pin."""

    def __init__(self):
        try:
            config = json.loads(OPENRGB_CONFIG.read_text())
            bridge = config["PhilipsHueDevices"]["bridges"][0]
            self.ip = str(ipaddress.ip_address(bridge["ip"]))
            self.username = bridge["username"]
        except (OSError, ValueError, KeyError, IndexError, TypeError):
            raise RoomError("No Hue bridge is paired in OpenRGB")
        if not isinstance(self.username, str) or not re.fullmatch(r"[A-Za-z0-9-]{1,64}", self.username):
            raise RoomError("The Hue bridge key in OpenRGB's settings is invalid")
        # The certificate is checked against the pin in request(), before the
        # key goes out, instead of against a CA.
        self.context = ssl.create_default_context()
        self.context.check_hostname = False
        self.context.verify_mode = ssl.CERT_NONE
        self.key_id = hashlib.sha256(self.username.encode()).hexdigest()

    def check_certificate(self, der):
        fingerprint = hashlib.sha256(der).hexdigest()
        try:
            fd = os.open(BRIDGE_PIN, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
            with os.fdopen(fd) as f:
                pin = json.loads(f.read(4096))
        except FileNotFoundError:
            pin = None
        except (OSError, ValueError) as e:
            raise RoomError(f"Can't read the Hue bridge pin {BRIDGE_PIN}: {e}")
        if isinstance(pin, dict) and pin.get("key") == self.key_id:
            if pin.get("sha256") != fingerprint:
                raise RoomError("The Hue bridge's certificate doesn't match the one pinned "
                                f"when it was first used. If you replaced or reset the bridge, "
                                f"pair it again in OpenRGB or delete {BRIDGE_PIN}")
            return
        # First use of this key, or OpenRGB was paired again: pin this bridge.
        try:
            write_private_json(BRIDGE_PIN, {"key": self.key_id, "sha256": fingerprint})
        except OSError as e:
            raise RoomError(f"Can't save the Hue bridge pin {BRIDGE_PIN}: {e}")

    def request(self, method, path, body=None):
        conn = http.client.HTTPSConnection(self.ip, 443, timeout=5, context=self.context)
        try:
            conn.connect()
            der = conn.sock.getpeercert(binary_form=True)
            if not der:
                raise RoomError("The Hue bridge sent no certificate")
            self.check_certificate(der)
            conn.request(method, f"/api/{self.username}{path}",
                         body=None if body is None else json.dumps(body),
                         headers={"Content-Type": "application/json"})
            response = conn.getresponse()
            data = response.read(BRIDGE_MAX_BODY + 1)
        except (OSError, http.client.HTTPException) as e:
            raise RoomError(f"Can't reach the Hue bridge: {e}")
        finally:
            conn.close()
        if len(data) > BRIDGE_MAX_BODY:
            raise RoomError("The Hue bridge sent an oversized reply")
        try:
            reply = json.loads(data)
        except ValueError:
            raise RoomError("The Hue bridge sent an invalid reply")
        if isinstance(reply, list) and reply and isinstance(reply[0], dict) and "error" in reply[0]:
            raise RoomError("The Hue bridge refused: " + str(reply[0]["error"].get("description", "")))
        return reply

    def area_lights(self, name):
        """Light ids in the Entertainment area OpenRGB names name."""
        groups = self.request("GET", "/groups")
        for group in groups.values() if isinstance(groups, dict) else ():
            if isinstance(group, dict) and group.get("type") == "Entertainment" and group.get("name") == name:
                return [i for i in group.get("lights", []) if isinstance(i, str) and i.isdigit()]
        raise RoomError(f"The Hue bridge has no Entertainment area named {name}")

    def light_state(self, light):
        state = self.request("GET", f"/lights/{light}").get("state", {})
        saved = {"on": bool(state.get("on")), "bri": state.get("bri")}
        mode = state.get("colormode")
        if mode == "ct":
            saved["ct"] = state.get("ct")
        elif mode == "xy":
            saved["xy"] = state.get("xy")
        elif mode == "hs":
            saved.update(hue=state.get("hue"), sat=state.get("sat"))
        return {k: v for k, v in saved.items() if v is not None}

    def set_light_state(self, light, state):
        self.request("PUT", f"/lights/{light}/state", state)


def room_enabled():
    try:
        return ROOM.read_text().strip() == "on"
    except OSError:
        return False


def write_private_json(path, value):
    """Write JSON through a unique temporary file, readable only by the user."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix="." + path.name + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(value))
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


class RoomSync:
    """Streams effects to Hue Entertainment areas while room sync is on.

    The lights keep the last streamed color when a stream ends, and the bridge
    doesn't report streamed colors, so each light's state is saved to
    ROOM_SNAPSHOT before the first stream and put back when sync stops. The
    snapshot outlives the daemon: one left behind by a crash is put back (or
    reused, if sync is still on) rather than taken again from lights that may
    still show streamed colors."""

    def __init__(self):
        self.active = {}            # device index -> Device, while streaming
        self.error = ""
        self.next_try = 0.0

    @staticmethod
    def areas(devices):
        return [d for d in devices if d.description.startswith(ROOM_STREAMING)
                and "Direct" in d.modes and "Disconnected" in d.modes]

    def start(self, client, devices, now):
        if now < self.next_try:
            return
        areas = self.areas(devices)
        try:
            if not ROOM_SNAPSHOT.exists():
                bridge = HueBridge()
                lights = {}
                for area in areas:
                    for light in bridge.area_lights(area.name):
                        if light not in lights:
                            lights[light] = bridge.light_state(light)
                write_private_json(ROOM_SNAPSHOT, {"lights": lights})
        except (RoomError, OSError) as e:
            # Never stream without a way to put the lights back.
            self.error, self.next_try = str(e), now + ROOM_RETRY
            return
        for area in areas:
            client.set_mode(area, "Direct")
            self.active[area.index] = area
        self.error = ""

    def stop(self, client):
        if client is not None:
            for area in self.active.values():
                try:
                    client.set_mode(area, "Disconnected")
                except OSError:
                    break
            if self.active:
                time.sleep(0.5)     # let the bridge end the stream first
        self.active.clear()
        self.restore()

    def restore(self):
        """Put the saved light states back; True once nothing is left to do."""
        try:
            saved = json.loads(ROOM_SNAPSHOT.read_text())
        except FileNotFoundError:
            return True
        except (OSError, ValueError):
            saved = {}
        try:
            lights = saved.get("lights", {}) if isinstance(saved, dict) else {}
            if lights:
                bridge = HueBridge()
                for light, state in lights.items():
                    if light.isdigit() and isinstance(state, dict):
                        bridge.set_light_state(light, state)
                        time.sleep(0.1)     # the bridge takes ~10 light commands a second
            ROOM_SNAPSHOT.unlink(missing_ok=True)
        except RoomError as e:
            self.error, self.next_try = str(e), time.monotonic() + ROOM_RETRY
            return False
        self.error = ""
        return True


# Effects

def read_effect():
    try:
        effect = STATE.read_text().strip()
    except OSError:
        effect = DEFAULT_EFFECT
    return effect if effect in EFFECTS else DEFAULT_EFFECT


def frame(effect, device, t, main, palette):
    if effect == "off":
        return [(0, 0, 0)] * device.led_count
    if effect == "static":
        return [main] * device.led_count
    if effect == "pulse":
        level = PULSE_FLOOR + (1 - PULSE_FLOOR) * (0.5 - 0.5 * math.cos(2 * math.pi * t / PULSE_PERIOD))
        return [scale(main, level)] * device.led_count
    shift = t / WAVE_PERIOD
    return [sample(palette, x - shift) for x, _ in device.positions]


def watched_files():
    """Identify the theme and effect files, so a theme switch (which replaces
    the theme directory) or an effect change is noticed without signals."""
    signature = []
    for path in (STATE, ROOM, THEME / "colors.toml", THEME / "keyboard.rgb"):
        try:
            st = path.stat()
            signature.append((st.st_ino, st.st_mtime_ns))
        except OSError:
            signature.append(None)
    return signature


def daemon_lock():
    """Open and lock the daemon's lock file, or return None if another daemon
    holds it. Kept open for the daemon's lifetime; the kernel drops the lock
    when the process exits, however it exits."""
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    lock = os.fdopen(fd, "r+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return None
    return lock


def daemon():
    lock = daemon_lock()
    if lock is None:
        sys.exit("omarchy-rgb: another daemon is already running")

    running = True

    def on_term(*_):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    client, devices = None, []
    headsets = {}
    room = RoomSync()
    loaded = written = plugged = None
    next_connect = next_poll = next_scan = 0.0
    last_sent = last_checked = 0.0
    start = time.monotonic()
    try:
        while running:
            now = time.monotonic()

            if now - last_checked >= 0.25:
                last_checked = now
                current = watched_files()
                if current != loaded:
                    loaded = current
                    colors = theme_colors()
                    accent = hex_rgb(colors.get("accent", "ffffff"))
                    keyboard = keyboard_color()
                    main = led_color(keyboard or accent)
                    palette = wave_palette(colors, accent, keyboard)
                    effect = read_effect()
                    room_on = room_enabled()
                    last_sent = 0.0
                    if effect == "manual":
                        # Headsets get their own lighting (and mic LED) back.
                        for path, headset in list(headsets.items()):
                            try:
                                headset.hand_back()
                            except OSError:
                                headsets.pop(path).close()

            if client is None and now >= next_connect:
                try:
                    client = Client()
                    devices, next_poll = [], now
                except OSError:
                    client, next_connect = None, now + 3

            if client is not None:
                try:
                    client.drain()
                    if client.devices_changed:
                        # Let the server finish detecting before re-listing.
                        client.devices_changed, devices, next_poll = False, [], now + 2
                        room.active.clear()
                    if not devices and now >= next_poll:
                        devices, next_poll, last_sent = client.devices(), now + 2, 0.0
                except (OSError, struct.error):
                    client.close()
                    client, devices, next_connect = None, [], now + 3
                    room.active.clear()

            if now >= next_scan:
                next_scan = now + HEADSET_SCAN
                hid = usb_hid_devices()
                if hid != plugged and plugged is not None and client is not None:
                    try:
                        client.rescan()
                    except OSError:
                        client.close()
                        client, devices, next_connect = None, [], now + 3
                        room.active.clear()
                plugged = hid
                present = find_headsets()
                for path in set(headsets) - set(present):
                    headsets.pop(path).close()
                for path in present:
                    try:
                        headset = headsets.setdefault(path, Headset(path))
                        if effect != "manual":
                            headset.take_control()
                    except OSError:
                        headsets.pop(path, None)
                last_sent = 0.0

            if not room_on or effect == "manual":
                if room.active:
                    room.stop(client)
                elif now >= room.next_try:
                    room.restore()
            elif client is not None and not room.active and RoomSync.areas(devices):
                try:
                    room.start(client, devices, now)
                except OSError:
                    client.close()
                    client, devices, next_connect = None, [], now + 3
                    room.active.clear()

            status = make_status(effect, main, palette, devices + list(headsets.values()))
            status["room"] = {
                "enabled": room_on,
                "available": bool(RoomSync.areas(devices)),
                "active": bool(room.active),
                "areas": [d.name for d in RoomSync.areas(devices)],
                "error": room.error,
            }
            if status != written:
                written = status
                write_status(status)

            animated = effect in ("pulse", "wave")
            if effect != "manual" and (animated or now - last_sent >= STATIC_REFRESH):
                t = now - start
                if client is not None:
                    try:
                        for device in devices:
                            if device.room and device.index not in room.active:
                                continue
                            client.update(device, frame(effect, device, t, main, palette))
                    except OSError:
                        client.close()
                        client, devices, next_connect = None, [], now + 3
                        room.active.clear()
                for path, headset in list(headsets.items()):
                    try:
                        headset.update(frame(effect, headset, t, main, palette))
                    except OSError:
                        headsets.pop(path).close()
                last_sent = now

            time.sleep(1 / FPS if animated else 0.25)
    finally:
        for headset in headsets.values():
            headset.release()
        # Nothing drives the room lights once the daemon is gone.
        room.stop(client)
        if client is not None:
            client.close()
        try:
            STATUS.unlink()
        except OSError:
            pass


# Status for the Omarchy panel

def hex_str(rgb):
    return "#%02x%02x%02x" % rgb


def make_status(effect, main, palette, devices):
    try:
        theme = (THEME.parent / "theme.name").read_text().strip()
    except OSError:
        theme = ""
    # The palette is stored bounced back on itself for a smooth loop; show
    # each color once.
    distinct = palette[:len(palette) // 2 + 1] if len(palette) > 2 else palette
    return {
        "effect": effect,
        "theme": theme,
        "color": hex_str(main),
        "palette": [hex_str(c) for c in distinct],
        "devices": [{"name": d.name, "type": d.type} for d in devices],
    }


def write_status(status):
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATUS.parent, prefix=".rgb-status.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(status))
        os.replace(tmp, STATUS)
    except BaseException:
        os.unlink(tmp)
        raise


def print_status():
    """Daemon status as one JSON object, for the Omarchy panel."""
    lock = daemon_lock()
    running = lock is None              # held by a running daemon
    if lock is not None:
        lock.close()
    status = {}
    if running:
        try:
            status = json.loads(STATUS.read_text())
        except (OSError, ValueError):
            pass
    status.update({"running": running, "effect": read_effect()})
    print(json.dumps(status))


def main():
    args = sys.argv[1:]
    if not args:
        print(read_effect())
    elif args[0] == "effect" and len(args) == 2 and args[1] in EFFECTS:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(args[1] + "\n")
    elif args[0] == "room" and len(args) == 2 and args[1] in ("on", "off", "toggle"):
        on = (not room_enabled()) if args[1] == "toggle" else args[1] == "on"
        ROOM.parent.mkdir(parents=True, exist_ok=True)
        ROOM.write_text("on\n" if on else "off\n")
    elif args == ["status"]:
        print_status()
    elif args == ["daemon"]:
        daemon()
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
